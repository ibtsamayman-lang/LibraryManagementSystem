<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Library System</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts & Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Literata:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary": "#162839",
                            "secondary": "#795900",
                            "surface-lowest": "#ffffff",
                            "surface-container-low": "#f4f3f0",
                            "surface-variant": "#e3e2df",
                            "on-surface-variant": "#43474c",
                            "outline-variant": "#c4c6cd",
                            "outline": "#74777d"
                        },
                        spacing: {
                            "gutter": "24px",
                            "container-max": "1280px"
                        }
                    }
                }
            }
    </script>
</head>
<body class="bg-[#faf9f6] text-[#1a1c1a] antialiased min-h-screen flex flex-col pt-16">

    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 shadow-sm fixed top-0 left-0 w-full z-50 flex justify-between items-center h-16 px-6 max-w-[1280px] mx-auto">
        <div class="flex items-center gap-8">
            <a class="text-xl font-bold text-[#162839]" asp-controller="Home" asp-action="Index">Library System</a>
            <div class="hidden md:flex items-center gap-6 font-semibold text-sm">
                <a class="text-[#162839] hover:text-[#795900] transition-colors" asp-controller="Home" asp-action="Index">Home</a>
                <a class="text-gray-600 hover:text-[#795900] transition-colors" asp-controller="Books" asp-action="Index">Books</a>
                <a class="text-gray-600 hover:text-[#795900] transition-colors" asp-controller="Categories" asp-action="Index">Categories</a>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <!-- Search Box (Mofified Layout) -->
            <div class="relative hidden sm:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg pointer-events-none">search</span>
                <input class="pl-10 pr-4 py-1.5 border border-gray-300 rounded-md bg-white text-sm focus:border-[#162839] focus:ring-1 focus:ring-[#162839] outline-none w-64 transition-all" placeholder="Search books..." type="text" />
            </div>

            <!-- User Icon -->
            <a asp-controller="Users" asp-action="Login" class="text-[#162839] hover:text-[#795900] p-2 rounded-full hover:bg-gray-100 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">account_circle</span>
            </a>
        </div>
    </nav>

    <!-- Main Dynamic Content -->
    <main class="flex-grow max-w-[1280px] w-full mx-auto px-6 py-6">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-[#f4f3f0] border-t border-gray-200 w-full py-6 px-6 flex flex-col md:flex-row justify-between items-center gap-4 mt-auto">
        <div class="font-bold text-[#162839]">Library System</div>
        <div class="flex gap-6 text-sm text-gray-600">
            <a class="hover:text-[#795900]" href="#">Privacy Policy</a>
            <a class="hover:text-[#795900]" href="#">Terms of Service</a>
        </div>
        <div class="text-sm text-gray-500">
            © 2026 Library System. All rights reserved.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
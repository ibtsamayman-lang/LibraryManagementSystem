<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryHub</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Library CSS -->
    <link rel="stylesheet" href="~/css/library.css" asp-append-version="true" />
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-lg library-navbar">
            <div class="container">
                <!-- LOGO -->
                <a class="navbar-brand library-logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-icon">
                        <i class="bi bi-book-half"></i>
                    </span>
                    <span>
                        Library<span class="logo-highlight">Hub</span>
                    </span>
                </a>

                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAVIGATION -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        <!-- BOOKS -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-book"></i> Books
                            </a>
                        </li>

                        <!-- AUTHORS (تمت إضافته للربط مع الـ AuthorController) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Author" asp-action="AboutAuthor" asp-route-id="1">
                                <i class="bi bi-person-lines-fill"></i> Authors
                            </a>
                        </li>

                        <!-- CATEGORIES -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags"></i> Categories
                            </a>
                        </li>

                        <!-- USERS -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="GetAll">
                                <i class="bi bi-people"></i> Users
                            </a>
                        </li>

                        <!-- REVIEWS -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Review" asp-action="Index">
                                <i class="bi bi-star"></i> Reviews
                            </a>
                        </li>

                        <!-- READING -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Read" asp-action="Index">
                                <i class="bi bi-bookmark"></i> Reading
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="library-main">
        <div class="container">
            @* هنا يتم عرض محتوى صفحة AboutAuthor أو AboutBook تلقائياً *@
            @RenderBody()
        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="library-footer">
        <div class="container">
            <div class="row align-items-center">
                <!-- FOOTER BRAND -->
                <div class="col-md-6">
                    <div class="footer-brand">
                        <i class="bi bi-book-half"></i> LibraryHub
                    </div>
                    <p class="footer-text">
                        Your gateway to a world of knowledge and stories.
                    </p>
                </div>

                <!-- FOOTER LINKS -->
                <div class="col-md-6 text-md-end">
                    <div class="footer-links">
                        <a asp-controller="Book" asp-action="Index">Books</a>
                        <a asp-controller="Categories" asp-action="Index">Categories</a>
                        <a asp-controller="Users" asp-action="GetAll">Users</a>
                        <a asp-controller="Review" asp-action="Index">Reviews</a>
                    </div>
                </div>
            </div>

            <hr class="footer-line" />

            <div class="text-center">
                <small class="copyright">
                    © 2026 Library Management System
                    <span class="mx-2">•</span>
                    Built for learning & knowledge
                </small>
            </div>
        </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
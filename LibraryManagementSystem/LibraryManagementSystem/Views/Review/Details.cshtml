@model LibraryManagementSystem.Models.Review

@{
    ViewData["Title"] = "Review Details";
}

<h1>Review Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Review ID</dt>
        <dd class="col-sm-10">@Model.ReviewId</dd>

        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.User.Name</dd>

        <dt class="col-sm-2">Book</dt>
        <dd class="col-sm-10">@Model.Book.Title</dd>

        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.Rating</dd>

        <dt class="col-sm-2">Comment</dt>
        <dd class="col-sm-10">@Model.CommentText</dd>

        <dt class="col-sm-2">Review Date</dt>
        <dd class="col-sm-10">@Model.ReviewDate</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ReviewId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
@model LibraryManagementSystem.Models.User

<h2>User Details</h2>

<div class="card p-3">

    <p>
        <strong>ID:</strong>
        @Model.UserId
    </p>

    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <p>
        <strong>Role:</strong>
        @Model.Role
    </p>

</div>

<br />

<a asp-action="GetAll" class="btn btn-secondary">
    Back to List
</a>

<a asp-action="Edit"
   asp-route-id="@Model.UserId"
   class="btn btn-warning">
    Edit
</a>
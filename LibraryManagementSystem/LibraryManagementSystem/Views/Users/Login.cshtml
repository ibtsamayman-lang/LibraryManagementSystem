@{
}
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 card p-4 shadow-sm">
            <h3 class="text-center mb-4">Welcome Back</h3>

            <!-- بداية النموذج المربوط بـ UsersController وأكشن Login -->
            <form asp-controller="Users" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">Email or Username</label>
                    <input type="text" name="username" class="form-control" placeholder="Enter your email" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Sign In</button>

                <div class="text-center">
                    <small>Don't have an account? <a asp-controller="Users" asp-action="Register">Sign Up</a></small>
                </div>
            </form>
        </div>
    </div>
</div>
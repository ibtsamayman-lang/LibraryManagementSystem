@{
}
@model LibraryManagementSystem.Models.User

@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card p-4 shadow-sm">
            <h3 class="text-center mb-4">Create Account</h3>

            <form asp-controller="Users" asp-action="Register" method="post">
                <!-- استخدام asp-for لربط المدخلات بخصائص موديل User مباشرة -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full Name</label>
                    <input asp-for="Name" class="form-control" placeholder="John Doe" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create password" required />
                </div>

                <button type="submit" class="btn btn-success w-100 mb-3">Register</button>

                <div class="text-center">
                    <small>Already have an account? <a asp-controller="Users" asp-action="Login">Login</a></small>
                </div>
            </form>
        </div>
    </div>
</div>
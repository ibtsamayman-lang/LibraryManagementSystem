@model LibraryManagementSystem.Models.User

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h2>Welcome back, @(Model?.Name ?? "User")!</h2>
    </div>

    <!-- بطاقات إحصائيات سريعة -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card p-3 border-left-primary shadow-sm">
                <h5>Books Borrowed / Read</h5>
                <p class="fs-4 fw-bold">12</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 border-left-success shadow-sm">
                <h5>Active Subscriptions</h5>
                <p class="fs-4 fw-bold">Premium</p>
            </div>
        </div>
    </div>

    <!-- قسم الأقسام أو الكتب المستعارة -->
    <h4>Recently Read</h4>
    <div class="row mt-3">
        <!-- يتم هنا عمل foreach لعرض الكتب المربوطة بالمستخدم من قاعدة البيانات -->
        <p class="text-muted">No recent activity found.</p>
    </div>
</div> *@

@model LibraryManagementSystem.Models.Read

@{
    ViewData["Title"] = "Edit Read";
}

<div class="container py-4">
    <h2>Edit Read</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ReadId" />

                <!-- قائمة المستخدمين -->
                <div class="mb-3">
                    <label class="form-label fw-bold">User</label>
                    <select asp-for="UserId" class="form-select" required>
                        <option value="">-- Select User --</option>
                        @if (ViewBag.Users != null)
                        {
                            foreach (var user in ViewBag.Users)
                            {
                                <!option value="@user.UserId" @(user.UserId == Model.UserId ? "selected" : "")>
                                    @user.Name (@user.Email)
                                </!option>
                            }
                        }
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <!-- قائمة الكتب -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Book</label>
                    <select asp-for="BookId" class="form-select" required>
                        <option value="">-- Select Book --</option>
                        @if (ViewBag.Books != null)
                        {
                            foreach (var book in ViewBag.Books)
                            {
                                <!option value="@book.BookId" @(book.BookId == Model.BookId ? "selected" : "")>
                                    @book.Title
                                </!option>
                            }
                        }
                    </select>
                    <span asp-validation-for="BookId" class="text-danger"></span>
                </div>

                <!-- الحالة -->
                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Reading">Reading</option>
                        <option value="Completed">Completed</option>
                        <option value="Plan to Read">Plan to Read</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>
@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Read Book";
}

<div class="container py-5">

    <div class="row">

        <!-- Book Cover -->
        <div class="col-md-4 text-center">

            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <img src="~/images/books/@Model.CoverImage"
                     alt="@Model.Title"
                     class="img-fluid rounded shadow"
                     style="max-height:450px; object-fit:cover;" />
            }

        </div>

        <!-- Book Information -->
        <div class="col-md-8">

            <h1 class="mb-3">
                @Model.Title
            </h1>

            <p class="text-muted">
                By @Model.Author?.Name
            </p>

            <hr />

            <p>
                <strong>Category:</strong>
                @Model.Category?.Name
            </p>

           
            <p>
                <strong>Publication Year:</strong>
                @Model.PublicationYear
            </p>

            <p>
                <strong>Price:</strong>

                @if (Model.Price == 0)
                {
                    <span class="text-success fw-bold">
                        Free
                    </span>
                }
                else
                {
                    <span class="fw-bold">
                        @Model.Price
                    </span>
                }
            </p>

            <hr />

            <h4>About this book</h4>

            <p>
                @Model.Description
            </p>

            <div class="alert alert-info mt-4">
                📖 The full book content will be available soon.
            </div>

            <a asp-action="Index"
               class="btn btn-secondary mt-2">
                ← Back to Books
            </a>

        </div>

    </div>

</div>